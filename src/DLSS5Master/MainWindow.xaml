<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DLSS5Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DLSS5Master.Views"
        Title="DLSS 5 Master">

  <Grid x:Name="Root" Background="#FF060B12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Brand artwork behind every page (set from Assets\Background.jpg in code). -->
    <Image x:Name="BackgroundArt" Grid.RowSpan="2" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <!-- Soft veil behind the text pages so the network-line art does not compete with the text. -->
    <Border x:Name="PageVeil" Grid.Row="1" Background="#A6060B12" Opacity="0" IsHitTestVisible="False">
      <Border.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Border.OpacityTransition>
    </Border>

    <!-- ===== Title / top bar ===== -->
    <Grid x:Name="TitleBar" Height="84" Padding="20,0,150,0" ColumnSpacing="16" Background="#66040A10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image x:Name="HeaderLogo" Height="68" VerticalAlignment="Center" Stretch="Uniform" />


      <SelectorBar x:Name="Tabs" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" SelectionChanged="Tabs_SelectionChanged">
        <SelectorBarItem x:Name="TabGames" Text="GAMES" IsSelected="True" />
        <SelectorBarItem x:Name="TabCommunity" Text="COMMUNITY" />
        <SelectorBarItem x:Name="TabSettings" Text="SETTINGS" />
        <SelectorBarItem x:Name="TabAbout" Text="ABOUT" />
      </SelectorBar>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
      <!-- New DLSS 5 Master version: shown only when GitHub has one. -->
      <Button x:Name="AppUpdateButton" Visibility="Collapsed" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="AppUpdateButton_Click">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE896;" FontSize="14" />
          <TextBlock x:Name="AppUpdateText" Text="Update" />
        </StackPanel>
      </Button>
      </StackPanel>
    </Grid>

    <!-- ===== Games page ===== -->
    <Grid x:Name="GamesPage" Grid.Row="1">
      <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
      <Grid.TranslationTransition><Vector3Transition Duration="0:0:0.25" /></Grid.TranslationTransition>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <!-- title, filters and summary for the library -->
      <StackPanel x:Name="GameTools" Spacing="10" Margin="30,6,34,4">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Games" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="LibraryCount" Foreground="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
          </StackPanel>
          <Button Grid.Column="1" AutomationProperties.Name="DLSS 5 on any window" ToolTipService.ToolTip="Draw DLSS 5 over a browser, a video or any other open window. Nothing in that program is changed." Click="AnyWindow_Click">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7F4;" FontSize="13" /><TextBlock Text="DLSS 5 on any window" /></StackPanel>
          </Button>
          <Button Grid.Column="2" ToolTipService.ToolTip="Add a game by its .exe" Click="AddGame_Click">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add a game" /></StackPanel>
          </Button>
          <Button Grid.Column="3" ToolTipService.ToolTip="Add a folder where every sub-folder is a game" Click="AddFolder_Click">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Add a folder" /></StackPanel>
          </Button>
          <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Find and scan your games again" Click="Refresh_Click">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Rescan" /></StackPanel>
          </Button>
        </Grid>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="170" /><ColumnDefinition Width="190" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search by game title…" QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
          <ComboBox x:Name="ApiFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="LibraryFilter_Changed">
            <ComboBoxItem Content="All APIs" Tag="" />
            <ComboBoxItem Content="DirectX 12" Tag="dx12" />
            <ComboBoxItem Content="DirectX 11" Tag="dx11" />
            <ComboBoxItem Content="Vulkan" Tag="vulkan" />
            <ComboBoxItem Content="Older (DX9 and below, OpenGL)" Tag="older" />
            <ComboBoxItem Content="Unknown" Tag="unknown" />
          </ComboBox>
          <ComboBox x:Name="DlssFilter" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="LibraryFilter_Changed">
            <ComboBoxItem Content="All DLSS states" Tag="" />
            <ComboBoxItem Content="Has DLSS" Tag="dlss" />
            <ComboBoxItem Content="Has Frame Generation" Tag="fg" />
            <ComboBoxItem Content="No DLSS" Tag="none" />
          </ComboBox>
          <ComboBox x:Name="StateFilter" Grid.Column="3" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="LibraryFilter_Changed">
            <ComboBoxItem Content="Any setup state" Tag="" />
            <ComboBoxItem Content="Ready for DLSS 5" Tag="ready" />
            <ComboBoxItem Content="Set up with DLSS 5 Master" Tag="installed" />
            <ComboBoxItem Content="Modded by another app" Tag="other" />
            <ComboBoxItem Content="Not modded" Tag="clean" />
          </ComboBox>
          <Button x:Name="ClearFiltersButton" Grid.Column="4" Content="Clear filters" Visibility="Collapsed" Click="EmptyClear_Click" />
        </Grid>
        <!-- the DLSS 5 overlay, while it runs (MainWindow.Overlay.cs) -->
        <InfoBar x:Name="OverlayBar" Title="DLSS 5 overlay" Severity="Success" IsClosable="False" IsOpen="False">
          <InfoBar.ActionButton><Button Content="Stop overlay" Click="OverlayStop_Click" /></InfoBar.ActionButton>
        </InfoBar>
        <!-- clickable totals; each one applies its filter (filled in code) -->
        <StackPanel x:Name="SummaryChips" Orientation="Horizontal" Spacing="8" />
      </StackPanel>
      <GridView x:Name="GameGrid" Grid.Row="1" Padding="24,0,24,24" IsItemClickEnabled="True" SelectionMode="None" ItemClick="GameGrid_ItemClick">
        <!-- The poster itself reacts to the mouse (see PosterCard_PointerEntered); no grey box around it. -->
        <GridView.Resources>
          <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
        </GridView.Resources>
        <!-- One section per store: "Steam  73 · 72 ready for DLSS 5". -->
        <GridView.GroupStyle>
          <GroupStyle HidesIfEmpty="True">
            <GroupStyle.HeaderContainerStyle>
              <Style TargetType="GridViewHeaderItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="6,8,6,4" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </GroupStyle.HeaderContainerStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate x:DataType="views:GameGroup">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{x:Bind Key}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{x:Bind CountText}" Foreground="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                  <Border Padding="10,2" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource AccentText}" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{x:Bind ReadyText}" FontSize="12" Foreground="{StaticResource AccentText}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </GridView.GroupStyle>
        <!-- Rows are centred so the space left over by the last column is shared evenly on both sides. -->
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="views:GameItem">
            <StackPanel Width="190" Margin="6" Spacing="8" Background="Transparent">
              <StackPanel.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Change artwork…" Click="ChangeArtwork_Click" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Refresh artwork" Click="RefreshArtwork_Click" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Use default artwork" Click="DefaultArtwork_Click" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </StackPanel.ContextFlyout>
              <Grid Height="270" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource RowBorder}" Background="#CC0D1824"
                    CenterPoint="95,135,0" PointerEntered="PosterCard_PointerEntered" PointerExited="PosterCard_PointerExited" PointerCanceled="PosterCard_PointerExited">
                <Grid.ScaleTransition><Vector3Transition Duration="0:0:0.15" /></Grid.ScaleTransition>
                <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" FontSize="44" FontWeight="Black"
                           Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" />
                <!-- what this app (or another one) installed here -->
                <Border Visibility="{x:Bind BadgeVisibility, Mode=OneWay}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,8,8,0"
                        Background="#E0101410" CornerRadius="8" Padding="8,3" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                  <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontSize="11" Foreground="{StaticResource AccentText}" MaxWidth="104" TextTrimming="CharacterEllipsis" />
                </Border>
                <!-- rendering API -->
                <Border Visibility="{x:Bind ApiVisibility, Mode=OneWay}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                        Background="{x:Bind ApiBackground, Mode=OneWay}" CornerRadius="8" Padding="8,3" ToolTipService.ToolTip="{x:Bind ApiName, Mode=OneWay}">
                  <TextBlock Text="{x:Bind ApiText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind ApiForeground, Mode=OneWay}" />
                </Border>
                <!-- DLSS version and Frame Generation on a dark strip at the bottom of the poster -->
                <Border Visibility="{x:Bind FactsVisibility, Mode=OneWay}" VerticalAlignment="Bottom" Padding="10,22,10,8">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#00060B12" Offset="0" />
                      <GradientStop Color="#E6060B12" Offset="0.55" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="8" Height="8" Fill="{x:Bind DlssDot, Mode=OneWay}" VerticalAlignment="Center" />
                      <TextBlock Text="{x:Bind DlssText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind FrameGenVisibility, Mode=OneWay}">
                      <Ellipse Width="8" Height="8" Fill="{StaticResource AccentText}" VerticalAlignment="Center" />
                      <TextBlock Text="FG" FontSize="12" FontWeight="SemiBold" ToolTipService.ToolTip="The game ships DLSS Frame Generation" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Spacing="1">
                <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
      <StackPanel x:Name="LoadingPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressRing IsActive="True" Width="40" Height="40" />
        <TextBlock x:Name="LoadingText" Text="Finding your games…" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" />
      </StackPanel>
      <!-- Nothing to show: no games at all, or none that match the search / filter. -->
      <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460" Visibility="Collapsed">
        <FontIcon Glyph="&#xE7FC;" FontSize="40" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="EmptyText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button x:Name="EmptyAdd" Style="{StaticResource AccentButtonStyle}" Click="AddGame_Click">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add a game" /></StackPanel>
          </Button>
          <Button x:Name="EmptyFolders" Click="EmptyFolders_Click">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Library folders" /></StackPanel>
          </Button>
          <Button x:Name="EmptyClear" Click="EmptyClear_Click">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE894;" FontSize="13" /><TextBlock Text="Clear search and filter" /></StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="ScanStatus" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,8" FontSize="11" Foreground="{StaticResource MutedText}" />
    </Grid>

    <!-- ===== Community page (sub-pages are filled in code) ===== -->
    <Grid x:Name="CommunityPage" Grid.Row="1" Visibility="Collapsed" Padding="24,8,24,16" RowSpacing="12">
      <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Grid.OpacityTransition>
      <Grid.TranslationTransition><Vector3Transition Duration="0:0:0.25" /></Grid.TranslationTransition>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="16,8">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <SelectorBar x:Name="CommunityTabs" SelectionChanged="CommunityTabs_SelectionChanged">
            <SelectorBarItem x:Name="CTabGames" Text="GAMES" IsSelected="True" />
            <SelectorBarItem x:Name="CTabChat" Text="CHAT" />
            <SelectorBarItem x:Name="CTabGallery" Text="GALLERY" />
            <SelectorBarItem x:Name="CTabPrivate" Text="PRIVATE" />
            <SelectorBarItem x:Name="CTabModerate" Text="MODERATE" Visibility="Collapsed" />
          </SelectorBar>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="NicknameButton" Click="Nickname_Click" ToolTipService.ToolTip="Your community nickname. Click to change it.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE77B;" FontSize="13" />
                <TextBlock x:Name="NicknameText" Text="Choose a nickname" />
              </StackPanel>
            </Button>
            <Button Click="CommunityRefreshTab_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Refresh" /></StackPanel></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <!-- GAMES -->
        <Grid x:Name="CGamesPage" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="180" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" />
              <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="CgSearch" Header="Search games" PlaceholderText="Game name" QueryIcon="Find"
                            QuerySubmitted="CgSearch_QuerySubmitted" TextChanged="CgSearch_TextChanged" />
            <ComboBox x:Name="CgRoute" Grid.Column="1" Header="Route" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CgFilter_Changed">
              <ComboBoxItem Content="All routes" Tag="" />
              <ComboBoxItem Content="Native" Tag="native" />
              <ComboBoxItem Content="Multipass" Tag="multipass" />
              <ComboBoxItem Content="Feeder" Tag="feeder" />
              <ComboBoxItem Content="OptiScaler" Tag="optiscaler" />
            </ComboBox>
            <ComboBox x:Name="CgApi" Grid.Column="2" Header="Rendering API" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CgFilter_Changed">
              <ComboBoxItem Content="All APIs" Tag="" />
              <ComboBoxItem Content="DirectX 12" Tag="dx12" />
              <ComboBoxItem Content="DirectX 11" Tag="dx11" />
              <ComboBoxItem Content="Vulkan" Tag="vulkan" />
              <ComboBoxItem Content="Older" Tag="older" />
            </ComboBox>
            <ComboBox x:Name="CgResult" Grid.Column="3" Header="Result" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CgFilter_Changed">
              <ComboBoxItem Content="All results" Tag="" />
              <ComboBoxItem Content="Working" Tag="working" />
              <ComboBoxItem Content="Mixed" Tag="mixed" />
              <ComboBoxItem Content="Not working" Tag="broken" />
            </ComboBox>
            <ComboBox x:Name="CgGpu" Grid.Column="4" Header="Graphics card" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CgFilter_Changed">
              <ComboBoxItem Content="All graphics cards" Tag="" />
              <ComboBoxItem Content="RTX 50" Tag="RTX 50" />
              <ComboBoxItem Content="RTX 40" Tag="RTX 40" />
              <ComboBoxItem Content="RTX 30" Tag="RTX 30" />
              <ComboBoxItem Content="RTX 20" Tag="RTX 20" />
              <ComboBoxItem Content="GTX" Tag="GTX" />
              <ComboBoxItem Content="AMD" Tag="AMD" />
              <ComboBoxItem Content="Intel" Tag="Intel" />
            </ComboBox>
          </Grid>
          <!-- whose games, then sort and clear on the right -->
          <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Sort" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
            <ComboBox x:Name="CgSort" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="CgFilter_Changed">
              <ComboBoxItem Content="Most recent" Tag="recent" />
              <ComboBoxItem Content="Most reports" Tag="reports" />
              <ComboBoxItem Content="Name" Tag="name" />
            </ComboBox>
            <Button x:Name="CgClear" Grid.Column="3" Content="Clear filters" VerticalAlignment="Center" Visibility="Collapsed" Click="CgClear_Click" />
          <SelectorBar x:Name="CgView" SelectionChanged="CgView_SelectionChanged">
            <SelectorBarItem x:Name="CgViewAll" Text="Everyone" IsSelected="True" ToolTipService.ToolTip="Every game players reported">
              <SelectorBarItem.Icon><FontIcon Glyph="&#xE716;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="CgViewMyGames" Text="My games" ToolTipService.ToolTip="Reports for the games in your library">
              <SelectorBarItem.Icon><FontIcon Glyph="&#xE7FC;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="CgViewMine" Text="My reports" ToolTipService.ToolTip="Games you rated">
              <SelectorBarItem.Icon><FontIcon Glyph="&#xE8BD;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
          </SelectorBar>
          </Grid>
          <ScrollViewer Grid.Row="2" x:Name="CgScroll">
            <StackPanel Spacing="10">
              <TextBlock x:Name="CgStatus" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" />
              <VariableSizedWrapGrid x:Name="CgGrid" Orientation="Horizontal" ItemWidth="420" ItemHeight="236" HorizontalAlignment="Center" />
              <Button x:Name="CgMore" Content="Show more" HorizontalAlignment="Center" Visibility="Collapsed" Click="CgMore_Click" />
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- CHAT -->
        <Grid x:Name="CChatPage" Visibility="Collapsed" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Community chat" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <!-- LIVE while new messages arrive every few seconds; OFFLINE when the server cannot be reached -->
            <Border x:Name="ChatLive" Grid.Column="1" Padding="9,2,10,3" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource AccentText}" VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="ChatLiveDot" Width="8" Height="8" Fill="{StaticResource AccentText}" VerticalAlignment="Center" />
                <TextBlock x:Name="ChatLiveText" Text="LIVE" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{StaticResource AccentText}" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="2" Text="Share results and discoveries with everyone. Pictures go to the Gallery." Foreground="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="ChatScroll" Padding="16,14,16,8" ViewChanged="ChatScroll_ViewChanged">
              <StackPanel x:Name="ChatList" Spacing="2" />
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="2" Spacing="6">
            <Border x:Name="ChatReplyBar" Visibility="Collapsed" Padding="12,6" CornerRadius="8" Background="{StaticResource RowBackground}">
              <Grid>
                <TextBlock x:Name="ChatReplyText" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedText}" Margin="0,0,30,0" />
                <Button HorizontalAlignment="Right" Padding="6,2" Click="ChatReplyCancel_Click" Content="✕" />
              </Grid>
            </Border>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="ChatInput" PlaceholderText="Message the community…" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                       PreviewKeyDown="ChatInput_PreviewKeyDown" />
              <Button Grid.Column="1" x:Name="ChatSend" Style="{StaticResource AccentButtonStyle}" Click="ChatSend_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE724;" FontSize="13" /><TextBlock Text="Send" /></StackPanel></Button>
            </Grid>
            <TextBlock x:Name="ChatStatus" FontSize="11" Foreground="{StaticResource MutedText}" />
          </StackPanel>
        </Grid>

        <!-- GALLERY -->
        <Grid x:Name="CGalleryPage" Visibility="Collapsed" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="14,10">
            <StackPanel Spacing="6">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="GalleryCaption" PlaceholderText="Say something about it (optional)" MaxLength="140" />
                <TextBox Grid.Column="1" x:Name="GalleryGame" PlaceholderText="Game (optional)" MaxLength="100" />
                <Button Grid.Column="2" x:Name="GalleryUpload" Style="{StaticResource AccentButtonStyle}" Click="GalleryUpload_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEB9F;" FontSize="13" /><TextBlock Text="Upload a picture…" /></StackPanel></Button>
              </Grid>
              <TextBlock x:Name="GalleryStatus" FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                         Text="Uploads are checked by the developer before anyone sees them." />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
              <VariableSizedWrapGrid x:Name="GalleryGrid" Orientation="Horizontal" ItemWidth="372" ItemHeight="290" HorizontalAlignment="Center" />
              <Button x:Name="GalleryMore" Content="Show more" HorizontalAlignment="Center" Visibility="Collapsed" Click="GalleryMore_Click" />
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- PRIVATE -->
        <Grid x:Name="CPrivatePage" Visibility="Collapsed" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="ASK THE DEVELOPER" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Messages here go only to the developer, never to the public chat." Foreground="{StaticResource MutedText}" FontSize="12" />
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="PrivateScroll" Padding="16,8">
              <StackPanel x:Name="PrivateList" Spacing="8" />
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PrivateAttach" ToolTipService.ToolTip="Attach a picture" Click="PrivateAttach_Click"><FontIcon Glyph="&#xE723;" FontSize="14" /></Button>
            <TextBox Grid.Column="1" x:Name="PrivateInput" PlaceholderText="Your question, bug report or idea…" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />
            <Button Grid.Column="2" x:Name="PrivateSend" Style="{StaticResource AccentButtonStyle}" Click="PrivateSend_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE724;" FontSize="13" /><TextBlock Text="Send" /></StackPanel></Button>
          </Grid>
        </Grid>

        <!-- MODERATE (developer only) -->
        <Grid x:Name="CModeratePage" Visibility="Collapsed" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <SelectorBar x:Name="ModTabs" SelectionChanged="ModTabs_SelectionChanged">
            <SelectorBarItem x:Name="MTabGallery" Text="Pictures to approve" IsSelected="True" />
            <SelectorBarItem x:Name="MTabPrivate" Text="Private messages" />
            <SelectorBarItem x:Name="MTabNotes" Text="Flagged notes" />
            <SelectorBarItem x:Name="MTabChat" Text="Chat" />
          </SelectorBar>
          <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ModList" Spacing="10" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- ===== Settings page ===== -->
    <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
      <ScrollViewer.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></ScrollViewer.OpacityTransition>
      <ScrollViewer.TranslationTransition><Vector3Transition Duration="0:0:0.25" /></ScrollViewer.TranslationTransition>
      <StackPanel MaxWidth="860" Margin="24,8,24,32" Spacing="14">
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="ADD-ON UPDATES" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                       Text="Newer add-on versions come from their authors' GitHub releases and are checked against GitHub's published SHA-256 before use. An update applies to new installs; games already set up keep their version until you reinstall them." />
            <Border Style="{StaticResource Card}" Padding="0">
              <StackPanel x:Name="UpdateRows" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="CheckUpdatesButton" Click="CheckUpdates_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Check now" /></StackPanel></Button>
              <CheckBox x:Name="AutoCheckBox" Content="Check once a day" Click="UpdateOptions_Click" />
              <CheckBox x:Name="PreReleaseBox" Content="Include beta / pre-release versions" Click="UpdateOptions_Click" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatus" FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="NVIDIA RUNTIME (nvngx_dlss*.dll, sl.*.dll)" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Text="DLSS, Frame Generation, Ray Reconstruction, neural rendering and Streamline runtimes are included with DLSS 5 Master. Leave empty to use them, or pick a folder that holds other versions." />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="RuntimeFolderBox" PlaceholderText="Automatic" IsReadOnly="True" />
              <Button Grid.Column="1" Click="PickRuntime_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Browse…" /></StackPanel></Button>
              <Button Grid.Column="2" Content="Automatic" Click="ClearRuntime_Click" />
            </Grid>
            <TextBlock x:Name="RuntimeStatus" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="RESHADE WITH ADD-ON SUPPORT" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Text="ReShade 6.8 with add-on support is included with DLSS 5 Master. Leave empty to use it, or pick a ReShade_Setup_x.y.z_Addon.exe from reshade.me to use another version." />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="ReShadeSourceBox" PlaceholderText="Automatic" IsReadOnly="True" />
              <Button Grid.Column="1" Click="PickReShade_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="13" /><TextBlock Text="Pick setup…" /></StackPanel></Button>
              <Button Grid.Column="2" Content="Automatic" Click="ClearReShade_Click" />
            </Grid>
            <TextBlock x:Name="ReShadeStatus" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="LIBRARY FOLDERS" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Text="Steam, Epic, GOG, Ubisoft and Xbox games are found automatically. Add folders where every sub-folder is a game (repacks, standalone games)." />
            <ListView x:Name="FolderList" SelectionMode="Single" MaxHeight="200" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Click="AddFolder_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add folder…" /></StackPanel></Button>
              <Button Click="RemoveFolder_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE738;" FontSize="13" /><TextBlock Text="Remove selected" /></StackPanel></Button>
              <Button Click="UnhideAll_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7B3;" FontSize="13" /><TextBlock Text="Show hidden games again" /></StackPanel></Button>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="DLL LIBRARY" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Text="DLSS, Frame Gen, Ray Reconstruction, FSR and XeSS builds you import here are offered by the Swap button in every game." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Click="ImportDlls_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B5;" FontSize="13" /><TextBlock Text="Import DLLs…" /></StackPanel></Button>
              <Button Click="OpenDllLibrary_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Open library folder" /></StackPanel></Button>
            </StackPanel>
            <TextBlock x:Name="DllLibraryStatus" FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                       Text="What DLSS 5 Master did, newest at the bottom: library scans, installs, restores and updates. Copy it into a bug report when something goes wrong." />
            <TextBox x:Name="ActivityLogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" Height="240"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Click="ActivityRefresh_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Refresh" /></StackPanel></Button>
              <Button Click="ActivityCopy_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="Copy log" /></StackPanel></Button>
              <Button Click="ActivityClear_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Clear" /></StackPanel></Button>
              <Button Click="OpenLog_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A5;" FontSize="13" /><TextBlock Text="Open file" /></StackPanel></Button>
            </StackPanel>
            <TextBlock x:Name="ActivityStatus" FontSize="12" Foreground="{StaticResource MutedText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="COMMUNITY" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                       Text="Each game panel shows what other players report: works, partly or broken, with the route and graphics card they used. Reading is anonymous. Nothing is sent unless you press Send on your own report: then the game, your rating, route, add-on versions, graphics card model and your note are shared, with a random ID for this install (no account, name or IP is stored)." />
            <CheckBox x:Name="CommunityBox" Content="Show community reports in game panels" Click="CommunityBox_Click" />
            <Expander Header="Moderator" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="12"
                           Text="For the developer only. With the moderator key, Community gets a MODERATE page to approve pictures, answer private messages and remove notes or chat messages. The key is checked with the server and kept encrypted for this Windows user." />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <PasswordBox x:Name="ModKeyBox" PlaceholderText="Moderator key" />
                  <Button Grid.Column="1" Content="Save" Click="ModKeySave_Click" />
                  <Button Grid.Column="2" Content="Remove" Click="ModKeyRemove_Click" />
                </Grid>
                <TextBlock x:Name="ModKeyStatus" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== About page ===== -->
    <ScrollViewer x:Name="AboutPage" Grid.Row="1" Visibility="Collapsed">
      <ScrollViewer.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></ScrollViewer.OpacityTransition>
      <ScrollViewer.TranslationTransition><Vector3Transition Duration="0:0:0.25" /></ScrollViewer.TranslationTransition>
      <StackPanel MaxWidth="860" Margin="24,8,24,32" Spacing="14">
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="8">
            <Image x:Name="AboutLogo" Height="150" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,6" />
            <TextBlock Text="DLSS 5 Master 0.9.1" FontSize="20" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                       Text="One place for ReShade + RenoDX neural rendering routes (Native, Multipass, Feeder), OptiScaler, and per-game DLL swapping. Every change is recorded in _DLSS5Master_Backup inside the game folder, and Restore originals puts the game back exactly as it was." />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="FEEDBACK" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                       Text="Found a bug or have an idea? Open an issue on GitHub. Your app version, Windows version and graphics card are filled in for you; add the game name and what happened. You can attach activity.log from the log folder." />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Style="{StaticResource AccentButtonStyle}" Click="ReportProblem_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEBE8;" FontSize="13" /><TextBlock Text="Report a problem" /></StackPanel></Button>
              <Button Click="SuggestFeature_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE82F;" FontSize="13" /><TextBlock Text="Suggest a feature" /></StackPanel></Button>
              <Button Click="OpenLogFolder_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Open log folder" /></StackPanel></Button>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Text="SUPPORT" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                       Text="DLSS 5 Master is free. If it saved you time, you can support its development." />
            <StackPanel Orientation="Horizontal" Spacing="28">
              <StackPanel Spacing="10" VerticalAlignment="Center">
                <ContentControl x:Name="AboutCoffeeHost" HorizontalAlignment="Left" />
                <TextBlock Text="buymeacoffee.com/Liongooder" Foreground="{StaticResource MutedText}" IsTextSelectionEnabled="True" />
              </StackPanel>
              <StackPanel Spacing="6">
                <Border Background="White" CornerRadius="12" Padding="8">
                  <Image x:Name="CoffeeQr" Width="140" Height="140" />
                </Border>
                <TextBlock Text="Scan with your phone" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource MutedText}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="8">
            <TextBlock Text="THIRD-PARTY NOTICES" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" x:Name="NoticesText" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Game panel (overlay) ===== -->
    <Grid x:Name="GameOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource OverlayBackground}" Tapped="GameOverlay_Tapped">
      <Border x:Name="GamePanel" MaxWidth="1040" Margin="40,30" Background="{StaticResource PanelBackground}" CornerRadius="22"
              BorderBrush="{StaticResource RowBorder}" BorderThickness="1" Tapped="GamePanel_Tapped">
        <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></Border.OpacityTransition>
        <Border.TranslationTransition><Vector3Transition Duration="0:0:0.22" /></Border.TranslationTransition>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- header -->
          <Grid Padding="28,22,22,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="54" Height="78" CornerRadius="8" Background="#FF0D1824">
              <Image x:Name="PanelPoster" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
              <TextBlock x:Name="PanelTitle" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel x:Name="PanelChips" Orientation="Horizontal" Spacing="6" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button ToolTipService.ToolTip="Rescan this game" Click="Rescan_Click"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
              <Button ToolTipService.ToolTip="Hide this game" Click="HideGame_Click"><FontIcon Glyph="&#xED1A;" FontSize="14" /></Button>
              <Button ToolTipService.ToolTip="Close" Click="ClosePanel_Click" Background="#40FF5050"><FontIcon Glyph="&#xE711;" FontSize="14" /></Button>
            </StackPanel>
          </Grid>

          <!-- body -->
          <ScrollViewer Grid.Row="1" Padding="28,6,28,10">
            <StackPanel Spacing="22" Padding="0,0,14,0">
              <!-- GAME: which exe and which renderer -->
              <StackPanel Spacing="8">
                <TextBlock Text="GAME" Style="{StaticResource SectionTitle}" />
                <Grid ColumnSpacing="14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Executable" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <ComboBox x:Name="ExeBox" HorizontalAlignment="Stretch" SelectionChanged="ExeBox_SelectionChanged" />
                      <Button Grid.Column="1" Click="ChangeExe_Click" ToolTipService.ToolTip="Pick the game's .exe yourself">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="13" /><TextBlock Text="Change .exe" /></StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Rendering API" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ApiBox" HorizontalAlignment="Stretch" SelectionChanged="ApiBox_SelectionChanged" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <!-- ROUTE: one card per way of running DLSS 5 (filled in code; the hidden boxes below hold the choice) -->
              <StackPanel Spacing="10">
                <TextBlock Text="HOW TO RUN DLSS 5" Style="{StaticResource SectionTitle}" />
                <Grid x:Name="RouteCards" ColumnSpacing="10" />
                <StackPanel x:Name="OptiBuildPanel" Visibility="Collapsed">
                  <TextBlock Text="OptiScaler build" Style="{StaticResource FieldLabel}" />
                  <ComboBox x:Name="OptiBuildBox" HorizontalAlignment="Stretch" SelectionChanged="OptiBuildBox_SelectionChanged" />
                </StackPanel>
                <TextBlock x:Name="RouteDescription" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />
                <InfoBar x:Name="RouteWarning" IsClosable="False" Severity="Warning" />
                <!-- The route choice itself (kept as the source of truth for installing). -->
                <StackPanel Visibility="Collapsed">
                  <ComboBox x:Name="BackendBox" SelectionChanged="BackendBox_SelectionChanged">
                    <ComboBoxItem Content="ReShade (RenoDX)" />
                    <ComboBoxItem Content="OptiScaler" />
                  </ComboBox>
                  <ComboBox x:Name="RouteBox" SelectionChanged="RouteBox_SelectionChanged" />
                </StackPanel>
              </StackPanel>

              <!-- OPTIONS -->
              <StackPanel Spacing="8">
              <TextBlock Text="OPTIONS" Style="{StaticResource SectionTitle}" />
              <!-- ReShade options -->
              <Border x:Name="ReShadeOptions" Style="{StaticResource Card}">
              <StackPanel Spacing="10">
                <StackPanel x:Name="ProxyPanel">
                  <TextBlock Text="ReShade DLL name" Style="{StaticResource FieldLabel}" />
                  <ComboBox x:Name="ProxyBox" Width="260" SelectedIndex="0">
                    <ComboBoxItem Content="dxgi.dll (default)" Tag="dxgi.dll" />
                    <ComboBoxItem Content="d3d11.dll (DX11 games that skip dxgi)" Tag="d3d11.dll" />
                  </ComboBox>
                </StackPanel>
                <CheckBox x:Name="AddDlssBox" Content="Add nvngx_dlss.dll beside the game if it has none" />
                <StackPanel>
                  <CheckBox x:Name="MfgBox" Content="MFG unlock — multi frame generation: DLSS 3x/4x on RTX 40, or Intel XeSS 2x–6x on RTX 20–50 (MFGAdaUnlock 1.6.0)" />
                  <TextBlock x:Name="MfgNote" Margin="28,0,0,0" FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
              </Border>

              <!-- OptiScaler options -->
              <Border x:Name="OptiOptions" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="OptiScaler DLL name" Style="{StaticResource FieldLabel}" />
                      <ComboBox x:Name="OptiHookBox" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="OptiScaler menu key" Style="{StaticResource FieldLabel}" />
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="MenuKeyBox" HorizontalAlignment="Stretch" />
                        <Button x:Name="ApplyKeyButton" Grid.Column="1" Content="Apply now" Click="ApplyKey_Click" ToolTipService.ToolTip="Change the key in the installed OptiScaler.ini" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <CheckBox x:Name="AntiCheatBox" Visibility="Collapsed" Content="This game has anti-cheat. I understand injected DLLs can get me banned online." />
              </StackPanel>

              <!-- status table -->
              <StackPanel Spacing="8">
                <TextBlock Text="STATUS" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="0">
                  <StackPanel x:Name="StatusRows" />
                </Border>
              </StackPanel>

              <!-- community reports (filled in code from the community server) -->
              <StackPanel x:Name="CommunitySection" Spacing="8">
                <Grid>
                  <TextBlock Text="COMMUNITY" Style="{StaticResource SectionTitle}" />
                  <HyperlinkButton x:Name="CommunityRefresh" Content="Refresh" HorizontalAlignment="Right" Padding="4,0" Click="CommunityRefresh_Click" />
                </Grid>
                <Border Style="{StaticResource Card}">
                  <StackPanel x:Name="CommunityPanel" Spacing="12" />
                </Border>
              </StackPanel>

              <!-- upscaler DLLs -->
              <StackPanel Spacing="8">
                <TextBlock Text="UPSCALER DLLS" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="0">
                  <StackPanel x:Name="DllRows" />
                </Border>
              </StackPanel>

              <!-- log -->
              <StackPanel Spacing="8">
                <TextBlock Text="ACTIVITY" Style="{StaticResource SectionTitle}" />
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" MaxHeight="220"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- footer -->
          <Grid Grid.Row="2" Padding="28,14,28,22" ColumnSpacing="10" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button ToolTipService.ToolTip="Open game folder" Click="OpenFolder_Click" Height="40"><FontIcon Glyph="&#xE8B7;" FontSize="16" /></Button>
            <Button Grid.Column="1" Click="Launch_Click" Height="40">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource AccentText}" /><TextBlock Text="Launch" /></StackPanel>
            </Button>
            <Button x:Name="RestoreButton" Grid.Column="2" Click="Restore_Click" Height="40" ToolTipService.ToolTip="Put every file this app changed back exactly as it was">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="14" /><TextBlock Text="Restore originals" /></StackPanel>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
              <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
              <TextBlock x:Name="BusyText" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="InstallButton" Grid.Column="4" Content="Set up DLSS 5" Style="{StaticResource AccentButtonStyle}"
                    Height="44" Padding="26,0" FontWeight="SemiBold" Click="Install_Click" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
