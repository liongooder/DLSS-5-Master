<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DLSS5Master</RootNamespace>
    <AssemblyName>DLSS5Master</AssemblyName>
    <Product>DLSS 5 Master</Product>
    <AssemblyTitle>DLSS 5 Master</AssemblyTitle>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.3.0</Version>
    <Company>Liongooder</Company>
    <Copyright>Copyright (c) 2026 Liongooder</Copyright>
    <ApplicationIcon>Assets\DLSS5Master.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\DLSS5Master.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TitleBar.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\DLSS5Master.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Background.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\BmcQr.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Third-party add-ons fetched and checksum-verified by build-installer.ps1 (see installer/THIRD-PARTY-NOTICES.txt). -->
    <Content Include="addons\*.addon64" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled runtimes (NVIDIA, ReShade, RenoDX, DLSS5-Feeder), staged by build-installer.ps1 from installer\payload-manifest.csv. -->
    <Content Include="payload\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Our own list of what the Feeder folder contains. -->
    <Content Include="..\..\installer\feeder-sources.txt" Link="payload\feeder\licenses\THIRD-PARTY-SOURCES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
