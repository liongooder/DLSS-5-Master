<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="DLSS5Master.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="SystemAccentColor">#FF6FD34A</Color>
      <Color x:Key="SystemAccentColorLight1">#FF8BE36A</Color>
      <Color x:Key="SystemAccentColorLight2">#FFA6EE8C</Color>
      <Color x:Key="SystemAccentColorLight3">#FFC4F6B1</Color>
      <Color x:Key="SystemAccentColorDark1">#FF57B536</Color>
      <Color x:Key="SystemAccentColorDark2">#FF3F8F24</Color>
      <Color x:Key="SystemAccentColorDark3">#FF2A6815</Color>

      <SolidColorBrush x:Key="AccentText" Color="#FF7FE05A" />
      <SolidColorBrush x:Key="WarnText" Color="#FFF2B84B" />
      <SolidColorBrush x:Key="ErrorText" Color="#FFFF6B6B" />
      <SolidColorBrush x:Key="MutedText" Color="#99FFFFFF" />
      <SolidColorBrush x:Key="PanelBackground" Color="#F20A121C" />
      <SolidColorBrush x:Key="RowBackground" Color="#1A9CC8FF" />
      <SolidColorBrush x:Key="RowBorder" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="OverlayBackground" Color="#B3020509" />

      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2,0,0,6" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RowBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource RowBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,14" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
